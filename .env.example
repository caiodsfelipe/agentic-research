# LLM providers (only the ones used in agentic_research/config.py NODE_SETTINGS are required)
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Tracing and evaluation (LangSmith, optional for tracing, required for the eval suite)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-research

# Project to analyze: the codebase the code reader explores
CODEBASE_PATH=/path/to/your/project

# Folder holding the "internal" and "external" Chroma vector stores (must be an ASCII-only path)
VECTOR_STORE_DIR=/path/to/vector_store

# Domain the agents act as experts in
RESEARCH_DOMAIN=AI and machine learning research

# Optional: how Serena is launched (default: uvx --from serena-agent==1.7.0 serena)
# SERENA_COMMAND=serena

# Optional: where finished runs are recorded (default: research_history.jsonl in the project root)
# RESEARCH_HISTORY_PATH=/path/to/research_history.jsonl
